# Copy this file to .env and fill in what you need. Everything is optional for local use.

# The address people open in their browser. Google sign-in and email links use it.
# Use http://localhost:5173 while running `npm run dev`, or your real https address in production.
APP_URL=http://localhost:3000
PORT=3000

# Leave empty to use the built-in database (stored in .data/). Set it to a Postgres server for real customers.
# DATABASE_URL=postgres://harmony:password@localhost:5432/harmony

# Seeds the dummy accounts and lists them on the sign-in page. Turn this off for real customers.
DEMO_MODE=true

# Google sign-in. Create an OAuth client (type "Web application") in Google Cloud Console and add
#   <APP_URL>/api/auth/google/callback
# as an authorised redirect URI. Without these, "Continue with Google" opens a clearly labelled demo stand-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email for password resets and invites, e.g. smtps://user:password@smtp.example.com:465
# Without it, emails are written to the server log instead of being sent.
# SMTP_URL=
# MAIL_FROM=Harmony <no-reply@yourdomain.com>

# Set to true behind a proxy or load balancer, so rate limits see the visitor's real address.
# TRUST_PROXY=false
